# Local secrets and credentials
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
id_rsa
id_ed25519
known_hosts

# Local compose contains a database password; keep it on this machine
/docker-compose.yml
/docker-compose.override.yml
/compose.override.yaml

